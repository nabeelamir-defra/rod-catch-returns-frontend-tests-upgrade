{
  "name": "rod-catch-returns-frontend-tests-upgrade",
  "type": "module",
  "scripts": {
    "test": "wdio run ./src/conf/local.conf.js",
    "lint": "eslint",
    "lint:fix": "npm run lint -- --fix",
    "docker-build": "docker build -t defra/rod-catch-returns-frontend-tests . && docker images",
    "docker-run": "docker run -v /dev/shm:/dev/shm -it --network host -v \"$(pwd)/logs:/app/logs/\" --env-file .env defra/rod-catch-returns-frontend-tests",
    "docker-test": "npm run docker-build && npm run docker-run"
  },
  "devDependencies": {
    "@wdio/cli": "9.23.2",
    "@wdio/cucumber-framework": "9.23.2",
    "@wdio/firefox-profile-service": "9.23.2",
    "@wdio/local-runner": "9.23.2",
    "@wdio/spec-reporter": "9.23.2",
    "debug": "4.4.3",
    "eslint": "9.39.2",
    "neostandard": "0.12.2",
    "wdio-wait-for": "3.1.1"
  }
}
